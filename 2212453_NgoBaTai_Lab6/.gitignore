## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# Build results
bin/
obj/
Debug/
Release/
x64/
x86/
build/
[Bb]uild/

# Visual Studio cache/options directory
.vs/

# NuGet Packages
packages/
*.nupkg
# Uncomment if necessary, but generally restore via NuGet
#!packages/build/

# Microsoft Azure Web App publish settings
*.PublishSettings

# Other files
node_modules/
