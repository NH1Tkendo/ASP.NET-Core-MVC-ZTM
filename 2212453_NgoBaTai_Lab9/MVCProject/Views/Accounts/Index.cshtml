@model IEnumerable<MVCProject.Models.Account>

@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Danh sách Account</h2>

<p>
    @Html.ActionLink("Create New", "Create")
</p>

@using (Html.BeginForm("Index", "Accounts", FormMethod.Get))
{
    <div>
        <label>Tìm theo AccountName hoặc FullName:</label>
        @Html.TextBox("searchString", ViewBag.SearchString as string, new { @class = "form-control" })
        <br />
        <input type="submit" value="Tìm kiếm" class="btn btn-primary" />
        <a href="@Url.Action("Index", "Accounts")" class="btn btn-default">Xóa lọc</a>
    </div>
}

<table class="table table-bordered">
    <tr>
        <th>
            @Html.ActionLink("AccountName", "Index", new { sortOrder = ViewBag.NameSortParm, searchString = ViewBag.SearchString })
        </th>
        <th>FullName</th>
        <th>Email</th>
        <th>Active</th>
        <th></th>
    </tr>

    @foreach (var account in Model)
    {
        <tr>
            <td>@account.AccountName</td>
            <td>@account.FullName</td>
            <td>@account.Email</td>
            <td>@account.Active</td>
            <td>
                @Html.ActionLink("Edit", "Edit", new { id = account.AccountID }) |
                @Html.ActionLink("Details", "Details", new { id = account.AccountID }) |
                @Html.ActionLink("Delete", "Delete", new { id = account.AccountID })
            </td>
        </tr>
    }

</table>

<!-- Phân trang -->
<div>
    @{
        int totalPages = (int)Math.Ceiling((double)ViewBag.TotalItems / ViewBag.PageSize);
        int currentPage = ViewBag.CurrentPage;
    }

    @for (int i = 1; i <= totalPages; i++)
    {
        if (i == currentPage)
        {
            @Html.Raw($"<strong>{i}</strong> ")
        }
        else
        {
            <a href="@Url.Action("Index", new { page = i, searchString = ViewBag.SearchString, sortOrder = ViewBag.CurrentSort })">@i</a>
        }
    }
</div>

